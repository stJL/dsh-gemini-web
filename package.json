{
  "name": "dsh-gemini-web",
  "version": "0.2.2-beta.1",
  "description": "Multi-site & multi-modal Gemini web quota orchestration plugin for DeepSeek Harness (AI Studio + Google Flow + Gemini Web via Chrome / Edge / Brave).",
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "build": "bun build src/index.ts --outfile index.js --target node",
    "prepublishOnly": "bun run build && rm -rf scripts/__pycache__",
    "sync:upstream": "python scripts/sync_upstream.py"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "scripts",
    "references",
    "requirements.txt",
    "SKILL.md",
    "SKILL.zh-CN.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "gemini",
    "gemini-web",
    "brave",
    "chrome",
    "llm-provider"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stJL/dsh-gemini-web.git"
  }
}