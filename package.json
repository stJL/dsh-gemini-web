{
  "name": "dsh-gemini-web",
  "version": "0.1.0",
  "description": "Multi-site & multi-modal Gemini web quota orchestration plugin for DeepSeek Harness (AI Studio + Google Flow + Gemini Web via Chrome / Edge / Brave).",
  "type": "module",
  "main": "./index.js",
  "scripts": {
    "build": "bun build src/index.ts --outfile index.js --target node",
    "sync:upstream": "python scripts/sync_upstream.py"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "gemini",
    "gemini-web",
    "brave",
    "chrome",
    "llm-provider"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ngcx/dsh-gemini-web.git"
  }
}